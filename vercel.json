{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "farmaciabiopharma.vercel.app" }],
      "destination": "https://www.farmaciabiopharmapoa.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "farmaciabiopharma.vercel.app" }],
      "destination": "https://www.farmaciabiopharmapoa.com.br/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).(webp|jpg|png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
